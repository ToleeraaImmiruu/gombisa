PORT=4000
CLIENT_URL=http://localhost:5173
# Public HTTPS address Chapa can reach (use ngrok/cloudflared while developing)
PUBLIC_API_URL=https://your-tunnel-url
CHAPA_SECRET_KEY=CHASECK_TEST-xxxxxxxx
# Random secret you also enter in the Chapa dashboard (Settings > Webhooks)
CHAPA_WEBHOOK_SECRET=change_me_to_a_long_random_string
SUPABASE_URL=https://your-project-ref.supabase.co
# SECRET: backend only. Never put this in the frontend or on GitHub.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
